name=citrix-workspace-app
version=23.2.0.10
release=2
summary="Citrix Workspace app for Linux"
summary_ru="Приложение Citrix Workspace для Linux"
group="Networking/Remote access"
desc="Citrix Workspace lets you access your enterprise files, applications, \
and desktops from your favorite device wherever you are."
desc_ru="Citrix Workspace предоставляет доступ к корпоративным файлам, \
приложениям и рабочим столам с любого устройства."
maintainer="Alexey Volkov <qualimock@altlinux.org>"
architectures=("amd64")
homepage="https://www.citrix.com/downloads/workspace-app/linux/"
license=("custom")

nonfree=1
nonfree_url="https://www.cloud.com/legal/agreements"

provides=()
conflicts=(ICAClient)

sources=(
	"https://web.archive.org/web/20230314134727id_/https://downloads.citrix.com/21641/ICAClient-rhel-${version}-0.x86_64.rpm?__gda__=exp=1678804225~acl=/*~hmac=3d33ee5e40cc357775187334e673017cd76c522825c00b8575f661de892be390&~name=${name}-${version}.rpm"
	"local:///org.gnome.shell.overrides.gschema.xml"
)

checksums=(
	"sha256:f0d969e1776e520ba1bf59c757d67c22ad8be8337dda0e3fc1b4f72aa0895002"
	"sha256:6a4e11738d81d04a5817d0738d62c6119a48d064a55e47286238c68363fc1abe"
)

deps=(
	libgtkglext
)

scripts=(
	['postinstall']='postinstall.sh'
	['preremove']='preremove.sh'
)

auto_reqprov_method=dirty
auto_req=1
auto_prov=1

# Optional legacy components: Heimdal GSSAPI (VDHSSPI, libkcph), GStreamer 0.10 and WebKitGTK 1.0 (UIDialogLibWebKit3 is used instead).
auto_req_filter=(
	"libgssapi\.so\.3"
	"-0\.10\.so"
	"libwebkitgtk-1\.0\.so"
	"libjavascriptcoregtk-1\.0\.so"
)

disable_network=1

package() {
	cp -a opt etc "${pkgdir}"/
	install -Dm0644 org.gnome.shell.overrides.gschema.xml \
		"${pkgdir}/usr/share/glib-2.0/schemas/org.gnome.shell.overrides.gschema.xml"
}

files() {
	files-find \
		"/opt/Citrix" \
		"/opt/Citrix/**/*" \
		"/etc/init.d/ctxcwalogd" \
		"/usr/share/glib-2.0/schemas/org.gnome.shell.overrides.gschema.xml"
}
